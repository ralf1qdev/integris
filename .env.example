# ─────────────────────────────────────────────────────────────
# Integris environment configuration
# Copy to `.env` in the repository root. Every app reads this file.
# Never commit real values. None of these are exposed to the browser.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the dashboard (no trailing slash).
APP_URL=http://localhost:3000

# PostgreSQL + Redis (see docker-compose.yml)
DATABASE_URL=postgresql://integris:integris@localhost:5432/integris
# Used only by integration tests. Must point at a disposable database.
DATABASE_URL_TEST=postgresql://integris:integris@localhost:5432/integris_test
REDIS_URL=redis://localhost:6379

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must exactly match a redirect registered under OAuth2 → Redirects.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Optional: register slash commands to one guild instantly during development.
DISCORD_DEV_GUILD_ID=

# Community bot (apps/community) — a SEPARATE Discord application that runs the
# official Integris server: welcome messages, suggestions and support tickets.
# Only needed if you run that server. See docs/COMMUNITY_SERVER.md.
COMMUNITY_BOT_TOKEN=
COMMUNITY_CLIENT_ID=
COMMUNITY_GUILD_ID=

# Secrets — generate each with: openssl rand -base64 32
# SESSION_SECRET signs CSRF tokens. ENCRYPTION_KEY (32 bytes, base64) encrypts
# stored OAuth tokens with AES-256-GCM. Rotating ENCRYPTION_KEY signs everyone out.
SESSION_SECRET=
ENCRYPTION_KEY=

# Monitoring
# Full reconciliation scan interval for every installed guild.
SCAN_INTERVAL_MINUTES=360
# Worker concurrency for scan jobs.
SCAN_CONCURRENCY=2
