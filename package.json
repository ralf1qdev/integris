{
  "name": "integris",
  "private": true,
  "description": "Integris \u2014 security for everything connected to your Discord.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @integris/web --filter @integris/bot --filter @integris/worker dev",
    "dev:web": "pnpm --filter @integris/web dev",
    "dev:bot": "pnpm --filter @integris/bot dev",
    "dev:worker": "pnpm --filter @integris/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:unit": "pnpm --filter @integris/security --filter @integris/shared test",
    "test:integration": "pnpm --workspace-concurrency=1 --filter @integris/database --filter @integris/worker --filter @integris/web test",
    "db:generate": "pnpm --filter @integris/database generate",
    "db:migrate": "pnpm --filter @integris/database migrate:dev",
    "db:deploy": "pnpm --filter @integris/database migrate:deploy",
    "commands:register": "pnpm --filter @integris/bot register-commands",
    "dev:community": "pnpm --filter @integris/community dev",
    "community:register": "pnpm --filter @integris/community register-commands"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
